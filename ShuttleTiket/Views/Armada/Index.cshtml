@model List<Armada>
@{ ViewData["Title"] = "Armada"; }

<div class="page-head">
    <h1>Armada</h1>
    <a asp-action="Create" class="btn btn-primary">Tambah armada</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>Kode</th><th>Kendaraan</th><th>Plat nomor</th><th class="num">Kapasitas</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="code">@a.KodeArmada</td>
                    <td>@a.NamaArmada</td>
                    <td>@a.PlatNomor</td>
                    <td class="num">@a.Kapasitas kursi</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Hapus armada ini?')">
                            <button class="link-btn link-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="muted py-4">Belum ada data armada.</td></tr>
            }
        </tbody>
    </table>
</div>
