@* detail booking dari SQL VIEW vw_detail_pemesanan *@
@model VwDetailPemesanan
@{ ViewData["Title"] = "Booking " + Model.KodeBooking; }

<div class="narrow" style="max-width: 640px">
    <div class="page-head">
        <div>
            <p class="small">Kode booking</p>
            <h1 class="code">@Model.KodeBooking</h1>
        </div>
        <span class="status status-@Model.StatusPembayaran">@Model.StatusPembayaran</span>
    </div>

    <dl class="info mb-4">
        <dt>Rute</dt><dd>@Model.KotaAsal &rarr; @Model.KotaTujuan</dd>
        <dt>Berangkat</dt><dd>@Format.Tanggal(Model.Tanggal), @Format.Jam(Model.JamBerangkat)</dd>
        <dt>Armada</dt><dd>@Model.NamaArmada (@Model.PlatNomor)</dd>
        <dt>Penumpang</dt><dd>@Model.NamaPenumpang<span class="sub">@Model.NoHp@(Model.Email != null ? " · " + Model.Email : "")</span></dd>
        <dt>Kursi</dt><dd>@Model.DaftarKursi (@Model.JumlahTiket tiket)</dd>
        <dt>Total</dt><dd class="fw-semibold">@Format.Rupiah(Model.TotalHarga)</dd>
        @if (Model.TanggalBayar.HasValue)
        {
            <dt>Dibayar</dt><dd>@Model.TanggalBayar.Value.ToString("dd/MM/yyyy HH:mm") via @Model.MetodePembayaran</dd>
        }
    </dl>

    @if (Model.StatusPembayaran == Pemesanan.StatusMenunggu)
    {
        <div class="panel panel-soft">
            <h2 class="mt-0">Pembayaran</h2>
            <p class="small muted">Simulasi: memilih metode lalu menekan Bayar langsung mengubah status menjadi LUNAS.</p>
            <form asp-action="Bayar" method="post" class="d-flex flex-wrap gap-2">
                <input type="hidden" name="kode" value="@Model.KodeBooking" />
                <select name="metode" class="form-select" style="max-width: 240px" required aria-label="Metode pembayaran">
                    <option value="">Pilih metode</option>
                    <option value="TRANSFER">Transfer bank</option>
                    <option value="QRIS">QRIS</option>
                    <option value="TUNAI">Tunai di loket</option>
                </select>
                <button class="btn btn-primary">Bayar</button>
            </form>
            <form asp-action="Batal" method="post" class="mt-3" onsubmit="return confirm('Batalkan pemesanan ini?')">
                <input type="hidden" name="kode" value="@Model.KodeBooking" />
                <button class="link-btn link-danger small">Batalkan pemesanan</button>
            </form>
        </div>
    }
    else if (Model.StatusPembayaran == Pemesanan.StatusLunas)
    {
        <a asp-action="ETiket" asp-route-kode="@Model.KodeBooking" class="btn btn-primary">Lihat e-ticket</a>
    }
</div>
